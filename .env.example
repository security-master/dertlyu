# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=

# Image providers
IMAGE_PROVIDER_PRIMARY=pollinations
IMAGE_PROVIDER_FALLBACK=huggingface

# Pollinations (https://enter.pollinations.ai)
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_MODEL=flux
POLLINATIONS_TIMEOUT_MS=90000

# Hugging Face Inference Providers
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_API_BASE_URL=https://router.huggingface.co
HF_TIMEOUT_MS=120000

# Database (Postgres — Netlify Database, Supabase, Neon, etc.)
# On Netlify Database, NETLIFY_DB_URL is injected automatically.
DATABASE_URL=
NETLIFY_DB_URL=

# Storage: local | blobs | r2 | memory
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/images
BLOBS_STORE_NAME=generated-images

# Cloudflare R2 (when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=

# Rate limiting (optional Upstash Redis)
RATE_LIMIT_ANON_PER_HOUR=10
RATE_LIMIT_AUTH_PER_HOUR=60
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
