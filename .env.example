# Image Provider Configuration (no API key required for default free mode)
IMAGE_PROVIDER_PRIMARY=pollinations-free
IMAGE_PROVIDER_FALLBACK=pollinations

# Pollinations Pro (optional — only if you have an API key from enter.pollinations.ai)
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_MODEL=flux
POLLINATIONS_TIMEOUT_MS=120000

# Hugging Face (required for Hugging Face provider)
HF_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
HF_TIMEOUT_MS=120000

# Database (optional in dev — uses in-memory store when unset)
DATABASE_URL=

# Supabase (optional — for auth and storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_URL=

# Cloudflare R2 / S3-compatible storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
S3_ENDPOINT=

# Rate Limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_ANONYMOUS=10
RATE_LIMIT_AUTHENTICATED=50
RATE_LIMIT_WINDOW_SECONDS=3600

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
